# Copy these into Netlify -> Site configuration -> Environment variables.
# Never commit real values. Nothing here is ever sent to the browser.

# ---- Database (Supabase) ----
# Note what is NOT here: the service-role key. The app reaches Postgres only
# through the yd_call gateway, which needs the publishable key AND the app
# secret below. A leaked page or publishable key therefore reads nothing.
SUPABASE_URL=
SUPABASE_ANON_KEY=
DB_APP_SECRET=

# ---- App secrets (invent long random strings) ----
APP_SESSION_SECRET=          # signs his login cookie
APP_AGENT_SECRET=            # DULCi sends this back as the x-yuan-secret header

# ---- Passcode ----
# Leave both blank and the agreed passcode 7563 works. To harden it:
#   node -e "console.log(require('crypto').createHash('sha256').update('7563'+'SALT').digest('hex'))"
APP_PIN_SALT=
APP_PIN_HASH=

# ---- DULCi (Invocations -> Webhook) ----
AGENT_WEBHOOK_URL=
AGENT_WEBHOOK_SECRET=

# ---- Optional: the human-readable Google Sheet mirror ----
GSHEET_WEBHOOK_URL=
